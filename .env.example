# =============================================================================
# Planner agents — copy to backend/.env (recommended: run uvicorn from backend/)
# pydantic-settings reads env_file=".env" relative to the process cwd.
# =============================================================================

# --- LLM provider (ollama | openai | anthropic) ---
LLM_PROVIDER=ollama

# Ollama (default; no API key)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional: fallback when /api/tags is empty; must match `ollama list` (e.g. qwen3-coder:latest)
# OLLAMA_MODEL=

# OpenAI (set LLM_PROVIDER=openai)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: Azure or proxy (default OpenAI API if unset)
# OPENAI_BASE_URL=

# Anthropic (set LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Council JSON ---
# Legacy single file (still used as fallback for council id "default")
# COUNCIL_CONFIG_PATH=/absolute/path/to/config/council.json
# Directory of config/councils/<id>.json profiles
# COUNCILS_DIR=/absolute/path/to/config/councils

# --- Research / web ---
RESEARCH_MAX_QUERIES=3
MAX_URL_FETCH_BYTES=200000
URL_FETCH_TIMEOUT_S=15

# --- HTTP client (LLM + tools) ---
REQUEST_TIMEOUT_S=120

# --- Orchestrator loop (council routing) ---
# Max orchestrator decisions per user message / clarification cycle
ORCHESTRATION_MAX_STEPS=24
# Max specialists invoked in parallel per call_agents step (asyncio.gather)
ORCHESTRATION_MAX_PARALLEL_AGENTS=6

# --- Planning ---
# Retries when plan JSON parse/validation fails
PLAN_JSON_RETRIES=2
# Reserved for older fixed-round flows; orchestrator mode uses ORCHESTRATION_* instead
DISCUSSION_ROUNDS=2

# --- Persistence ---
# SQLite session store (primary)
# SQLITE_PATH=/absolute/path/to/data/planner.db
# Legacy JSON sessions directory (import / fallback)
# SESSIONS_DATA_DIR=/absolute/path/to/data/sessions

# --- Production UI (optional) ---
# Serve Vite build from FastAPI; leave unset for npm run dev on :5173
# FRONTEND_DIST=/absolute/path/to/frontend/dist
