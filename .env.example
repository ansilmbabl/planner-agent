# Copy to backend/.env or project root — pydantic loads from backend when started from backend/
# Ollama (default; no API key)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
LLM_PROVIDER=ollama

# Optional: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Optional: Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Council config (default: ../config/council.json from backend app)
# COUNCIL_CONFIG_PATH=/absolute/path/to/council.json

# Serve built UI from FastAPI (optional; otherwise use Vite dev on :5173)
# FRONTEND_DIST=/path/to/frontend/dist
